/.git
/.github
/.gitignore
/.gitattributes
/.editorconfig
/.distignore
/.claude
/.idea
/.vscode
/.DS_Store
/node_modules
/vendor
# The React admin source (apps/admin), package.json and pnpm-lock.yaml ship in
# the zip so reviewers can read and rebuild assets/dist. Only local dev
# leftovers inside apps/ are dropped.
/apps/admin/.dev
/apps/admin/node_modules
*.tsbuildinfo
/tests
/docs
/release.sh
/makepot.sh
/composer.json
/composer.lock
/package-lock.json
/yarn.lock
/pnpm-workspace.yaml
/phpcs.xml.dist
/phpstan.neon
/phpstan-bootstrap.php
/phpunit.xml
/phpunit.xml.dist
# Unit tests of the admin app (the app source itself ships).
/apps/admin/vitest.config.ts
/apps/admin/src/test
*.test.ts
/scripts
/stubs
/i18n/extracted-strings.js
/.eslintrc*
/.prettierrc*
# No markdown ships in a production build (WordPress reads readme.txt); this
# also keeps stray dev notes (plan, session logs) out of the zip so Plugin
# Check's root-markdown scan stays clean.
*.md
# Regeneratable tooling caches (hidden files Plugin Check rejects).
.phpunit.result.cache
.phpcs.cache
**/*.map
**/*.log
**/.DS_Store
**/.gitkeep
