# No markdown ships in a production build (WordPress reads readme.txt); this
# also keeps stray dev notes (plan, session logs) out of the zip so Plugin
# Check's root-markdown scan stays clean.
*.md
# Regeneratable tooling caches (hidden files Plugin Check rejects).
.phpunit.result.cache
.phpcs.cache
**/*.map
**/*.log
**/.DS_Store
**/.gitkeep
